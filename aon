#!/bin/bash
# aon - Archaon OS package manager wrapper
# Wraps pacman + yay with simpler syntax

RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
NC='\033[0m'

case "$1" in
  install|i)
    yay -S "${@:2}"
    ;;
  remove|r)
    yay -Rns "${@:2}"
    ;;
  update|u)
    yay -Syu
    ;;
  search|s)
    yay -Ss "${@:2}"
    ;;
  list|l)
    pacman -Q
    ;;
  info)
    yay -Si "${@:2}"
    ;;
  clean)
    yay -Sc
    ;;
  *)
    echo -e "${CYAN}aon - Archaon OS package manager${NC}"
    echo ""
    echo -e "Usage: aon <command> [package]"
    echo ""
    echo -e "${GREEN}Commands:${NC}"
    echo "  install, i   Install a package"
    echo "  remove, r    Remove a package"
    echo "  update, u    Update all packages"
    echo "  search, s    Search for a package"
    echo "  list, l      List installed packages"
    echo "  info         Show package info"
    echo "  clean        Clean package cache"
    ;;
esac
